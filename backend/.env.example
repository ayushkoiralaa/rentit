# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/rentit

# Auto-creates demo login accounts (admin/owner/renter) + base categories on
# every server start, if they don't already exist yet. Never deletes data.
# Set to false for a real production deployment.
AUTO_SEED=true

# Auth
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Business rules
PLATFORM_FEE_PERCENT=10

# File uploads
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_ITEM=8
